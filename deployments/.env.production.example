# F4F Arena Production Environment Configuration
# Copy this file to .env.production and replace all placeholder values!

# Public domain pointed at your VPS IP (Caddy automatically provisions Let's Encrypt HTTPS)
DOMAIN_NAME=api.f4f-arena.example.com

# Database Configuration (internal Docker network only)
POSTGRES_DB=f4f_arena
POSTGRES_USER=f4f_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_32_CHAR_DB_PASSWORD

# Go Server Configuration
SERVER_ENV=production

# Admin Authentication
# Generate strong random strings: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_STRONG_ADMIN_PASSPHRASE
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_JWT_SECRET
TOKEN_EXPIRY_HOURS=24
